# This file is created automatically at:
# ~/.config/vikunja-calendar/vikunja.conf
# The copy here documents the available settings.

VIKUNJA_URL="https://vikunja.example.com"
VIKUNJA_TOKEN="tk_replace_with_an_api_token"

# Optional. New tasks default to the first writable project when omitted.
VIKUNJA_DEFAULT_PROJECT_ID=1
